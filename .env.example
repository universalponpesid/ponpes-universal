# Commerce operating mode: single_store | marketplace
COMMERCE_MODE=single_store
COMMERCE_DEFAULT_TENANT_ID=universal
COMMERCE_FEATURE_AFFILIATE=true
COMMERCE_FEATURE_PRODUCT_REVIEWS=true
COMMERCE_FEATURE_STORE_REVIEWS=false

# Tenant store data source (single_store mode)
# Required for local single-store catalog/data access.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Platform tenant registry spreadsheet (marketplace mode only)
PLATFORM_GOOGLE_SHEETS_SPREADSHEET_ID=

# Public storefront presentation
NEXT_PUBLIC_TENANT_ID=universal
NEXT_PUBLIC_STORE_ID=universal-mart
NEXT_PUBLIC_STORE_NAME=Universal Mart
NEXT_PUBLIC_STORE_SHORT_NAME=Universal Mart
NEXT_PUBLIC_STORE_DESCRIPTION=Official online store of Universal Pesantren.
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_STORE_EMAIL=
NEXT_PUBLIC_STORE_WHATSAPP=

# LEGACY single-store provider fallback. Keep only while tenant provider tabs are not configured.
# Never commit real values. Once provider rows are added, tenant secret_ref values resolve via Google Secret Manager.
BITESHIP_API_KEY=
BITESHIP_ORIGIN_POSTAL_CODE=
MIDTRANS_ENABLED=false
MIDTRANS_ENVIRONMENT=sandbox
MIDTRANS_SERVER_KEY=
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
NEXT_PUBLIC_MANUAL_BANK_NAME=
NEXT_PUBLIC_MANUAL_BANK_ACCOUNT_NAME=
NEXT_PUBLIC_MANUAL_BANK_ACCOUNT_NUMBER=
NEXT_PUBLIC_MANUAL_QRIS_IMAGE_URL=

# Tenant runtime configuration cache (0 disables cache; maximum 300000)
TENANT_CONFIG_CACHE_TTL_MS=45000

# Secret references use full resource names, e.g. projects/my-project/secrets/tenant-universal-midtrans/versions/latest.
# Grant the service account roles/secretmanager.secretAccessor on only the secrets it needs.

# Protects server-side operational reconciliation endpoints. Use a long random secret.
ADMIN_OPERATIONS_TOKEN=
# Admin payment review (use a long random token; never expose it as NEXT_PUBLIC_*).
ADMIN_OPERATIONS_NAME=Admin Operasional
